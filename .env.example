# =====================================================================
# VisionX Environment Configuration (.env.example)
# Copy this file to .env and configure your local or production settings.
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI Vision & Assistant Credentials
# ---------------------------------------------------------------------
# Grok (xAI) or Groq API key for Strands Conversational Agent
GROK_API=your_grok_or_groq_api_key_here

# Roboflow Universe Pretrained Waste Detection Model
# Universe Project: https://universe.roboflow.com/ting-ting-s-workspace/yolo-waste-detection-28enj
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=ting-ting-s-workspace
ROBOFLOW_PROJECT=yolo-waste-detection-28enj
ROBOFLOW_VERSION=1

# Ultralytics Person Detection Model (COCO class 0)
ULTRALYTICS_MODEL=yolov8n.pt
VISIONX_DEVICE=cpu

# ---------------------------------------------------------------------
# 2. MySQL Database Configuration (XAMPP / WAMP / Local / Cloud)
# ---------------------------------------------------------------------
# Default XAMPP MySQL runs on 127.0.0.1:3306 with user 'root' and empty password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=visionx

# ---------------------------------------------------------------------
# 3. Server-Managed Session & Cookie Security
# ---------------------------------------------------------------------
# 32+ character random secret for signing / salting tokens
SESSION_SECRET=visionx_dev_secret_replace_in_production_key_32bytes
SESSION_COOKIE_NAME=visionx_session
SESSION_MAX_AGE_SECONDS=604800
# Set to 'true' in production with HTTPS; 'false' for local HTTP development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend Origin for CORS with credentials
FRONTEND_ORIGIN=http://127.0.0.1:5173

# ---------------------------------------------------------------------
# 4. Email Delivery (SMTP) for Registration OTP Verification
# ---------------------------------------------------------------------
# Leave SMTP_HOST empty for local dev mode (OTPs are safely logged in server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VisionX <no-reply@visionx.local>
SMTP_USE_TLS=true
